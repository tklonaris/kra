# Docker PostgreSQL administrator. Do not commit the real .env file.
SPRING_PROFILES_ACTIVE=payments

KRA_DB_ADMIN_USER=postgres
KRA_DB_ADMIN_PASSWORD=replace-me
KRA_POSTGRES_MAX_REPLICATION_SLOTS=4
KRA_POSTGRES_MAX_WAL_SENDERS=4

# Application connections to the Docker PostgreSQL service.
KRA_DB_NAME=kra
KRA_DB_R2DBC_URL=r2dbc:postgresql://localhost:5432/kra?schema=kra
KRA_DB_JDBC_URL=jdbc:postgresql://localhost:5432/kra?currentSchema=kra
KRA_DB_APP_USER=kra_app
KRA_DB_APP_PASSWORD=replace-me
KRA_DB_MIGRATOR_USER=kra_migrator
KRA_DB_MIGRATOR_PASSWORD=replace-me
KRA_CDC_USER=kra_cdc
KRA_CDC_PASSWORD=replace-me
KRA_CDC_STATE_USER=kra_cdc_state
KRA_CDC_STATE_PASSWORD=replace-me

# Temporal's local PostgreSQL role and databases.
KRA_TEMPORAL_DB_USER=temporal
KRA_TEMPORAL_DB_PASSWORD=temporal-local-only
KRA_TEMPORAL_DB_NAME=temporal
KRA_TEMPORAL_VISIBILITY_DB_NAME=temporal_visibility

# Shared Debezium publication and replication slot.
KRA_CDC_PUBLICATION=kra_outbox_publication
KRA_CDC_SLOT_NAME=kra_outbox_slot

# Optional R2DBC pool tuning. The application.yaml defaults are used when omitted.
KRA_R2DBC_POOL_INITIAL_SIZE=5
KRA_R2DBC_POOL_MIN_IDLE=0
KRA_R2DBC_POOL_MAX_SIZE=20
KRA_R2DBC_POOL_MAX_ACQUIRE_TIME=20s
KRA_R2DBC_POOL_ACQUIRE_RETRY=2
KRA_R2DBC_POOL_MAX_CREATE_CONNECTION_TIME=5s
KRA_R2DBC_POOL_MAX_VALIDATION_TIME=10s
KRA_R2DBC_POOL_MAX_IDLE_TIME=3m
KRA_R2DBC_POOL_MAX_LIFE_TIME=4m

# RabbitMQ
KRA_RABBITMQ_HOST=localhost
KRA_RABBITMQ_PORT=5672
KRA_RABBITMQ_USER=kra_rabbitmq
KRA_RABBITMQ_PASSWORD=replace-me

# Temporal service and payment-workflow timing.
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=kra
TEMPORAL_PAYMENT_TASK_QUEUE=kra.payment.v1
PAYMENTS_CHECKOUT_WINDOW=30m
TEMPORAL_PAYMENT_PROCESSING_GRACE_PERIOD=60m
TEMPORAL_PAYMENT_ACTIVITY_START_TO_CLOSE_TIMEOUT=2m
TEMPORAL_PAYMENT_ACTIVITY_SCHEDULE_TO_CLOSE_TIMEOUT=10m
TEMPORAL_PAYMENT_ACTIVITY_MAXIMUM_ATTEMPTS=3
TEMPORAL_PAYMENT_WORKFLOW_RUN_TIMEOUT=135m

# Stripe test-mode credentials. Values are injected into the payment application, never committed.
# Obtain STRIPE_API_KEY from Stripe's test-mode Developers dashboard. `stripe listen` prints the
# listener-specific STRIPE_WEBHOOK_SECRET; replace it each time the listener is restarted.
STRIPE_API_KEY=replace-me
STRIPE_WEBHOOK_SECRET=replace-me
# Base64 encoding of exactly 32 random bytes.
PAYMENTS_CLIENT_SECRET_ENCRYPTION_KEY=replace-me
PAYMENTS_STRIPE_BLOCKING_IO_CONCURRENCY=8
